<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net8.0-windows</TargetFramework>
  <UseWPF>true</UseWPF>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>Yangi lotin klaviatura</AssemblyName>
  <Version>1.1.0</Version>
  <DefaultItemExcludes>$(DefaultItemExcludes);installer/**;WebUI/node_modules/**;artifacts/**</DefaultItemExcludes>
  <ApplicationIcon>Assets\yangi-logo.ico</ApplicationIcon>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  <Resource Include="Assets\yangi-logo.png" />
  <Content Include="WebUI\dist\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
   <Link>WebUI\%(RecursiveDir)%(Filename)%(Extension)</Link>
  </Content>
 </ItemGroup>
 <Target Name="RequireBuiltWebUI" BeforeTargets="PrepareForBuild" Condition="!Exists('WebUI/dist/index.html')">
  <Error Text="Build the React UI first: cd WebUI &amp;&amp; npm ci &amp;&amp; npm run build" />
 </Target>
</Project>
