<Window x:Class="YangiInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yangi lotin klaviatura — o‘rnatish"
        Width="560" Height="640" MinWidth="510" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#EDF2FB" FontFamily="Segoe UI" Icon="logo.png">
 <Window.Resources>
  <Style x:Key="AppleCheckbox" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Foreground" Value="#182033"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" Background="#F9FBFF" BorderBrush="#AAB6C9" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Path x:Name="Tick" Data="M 3,7 L 6,10 L 12,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
       </Border>
       <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Box" Property="Background" Value="#0875EE"/>
        <Setter TargetName="Box" Property="BorderBrush" Value="#0875EE"/>
        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.84"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Box" Property="BorderBrush" Value="#004DAE"/>
        <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Background" Value="#0875EE"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="22,12"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#0049AA"/>
        <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="LangPill" TargetType="Button">
   <Setter Property="Background" Value="#DCE5F5"/>
   <Setter Property="Foreground" Value="#1E293B"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="11,5"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.85"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="38,24">
   <Grid>
    <Image Source="logo.png" Width="84" Height="84" HorizontalAlignment="Left"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
     <Button x:Name="LangUzButton" Content="UZ" Style="{StaticResource LangPill}" Click="LangUz_Click" Margin="0,0,6,0"/>
     <Button x:Name="LangRuButton" Content="RU" Style="{StaticResource LangPill}" Click="LangRu_Click"/>
    </StackPanel>
   </Grid>
   <TextBlock Text="Yangi lotin klaviatura" FontFamily="Georgia" FontSize="28" Margin="0,15,0,0" Foreground="#131726"/>
   <TextBlock x:Name="SubtitleText" Text="Windows uchun o‘rnatish" FontSize="15" Foreground="#65718A" Margin="0,5,0,22"/>
   <Border x:Name="OptionsCard" Background="#FAFBFE" CornerRadius="18" Padding="22">
    <StackPanel>
     <TextBlock x:Name="CardTitle" Text="O‘rnatishga tayyor" FontSize="19" FontWeight="SemiBold" Foreground="#161B2C"/>
     <TextBlock x:Name="CardDescription" Text="Dastur joriy foydalanuvchi uchun o‘rnatiladi. Ishlash uchun .NET Desktop Runtime 8 va Microsoft Edge WebView2 Runtime talab qilinadi." TextWrapping="Wrap" FontSize="14" Foreground="#59677E" Margin="0,8,0,16"/>
     <Border x:Name="WebViewWarning" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#F5C26B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock x:Name="WebViewWarningText" TextWrapping="Wrap" FontSize="12.5" Foreground="#6B4400"/>
       <Button x:Name="WebViewDownloadButton" Style="{StaticResource LangPill}" Background="#FFE2B3" Foreground="#5C3A00" HorizontalAlignment="Left" Margin="0,8,0,0" Click="DownloadWebView_Click"/>
      </StackPanel>
     </Border>
     <CheckBox Style="{StaticResource AppleCheckbox}" x:Name="AutoStart" Content="Windows bilan birga trayda ishga tushirish" FontSize="15" Padding="3" IsChecked="False"/>
     <TextBlock x:Name="OptionDescription" Text="Bu parametrni o‘rnatish vaqtida tanlash mumkin." Foreground="#65718A" FontSize="12" Margin="23,6,0,0"/>
    </StackPanel>
   </Border>
   <Button x:Name="InstallButton" Content="O‘rnatish" Style="{StaticResource Action}" Click="Install_Click" Margin="0,22,0,0"/>
   <TextBlock x:Name="Status" FontSize="13" Foreground="#4F5F79" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel>
 </ScrollViewer>
</Window>
