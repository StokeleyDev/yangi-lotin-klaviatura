<Window x:Class="UzbekKeyboard.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Yangi lotin klaviatura" Width="1040" Height="860" MinWidth="720" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#E4DFF6" Closing="Window_Closing">
 <Grid>
  <wv:WebView2 x:Name="Browser" />
  <Border x:Name="Loading" Background="#E4DFF6" Padding="32">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
    <TextBlock Text="Yangi lotin klaviatura" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock x:Name="LoadingText" Text="Interfeys yuklanmoqda… / Загрузка интерфейса…" TextWrapping="Wrap"/>
    <Button x:Name="Retry" Content="Qayta urinish / Повторить" Click="Retry_Click" Visibility="Collapsed" Padding="16,10" Margin="0,20,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
