<Window x:Class="UzbekKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yangi lotin klaviatura" Icon="Assets/yangi-logo.png"
        Width="740"
        Height="672"
        MinWidth="620"
        MinHeight="600"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="12"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="AppleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent" Height="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True"/>
                    <Border x:Name="Track" Grid.Column="1" Width="42" Height="25" CornerRadius="13" Background="#BFC4CE" VerticalAlignment="Center" Margin="0,3,0,0">
                        <Border x:Name="Knob" Width="21" Height="21" CornerRadius="11" Background="White" HorizontalAlignment="Left" Margin="2,0,0,0"><Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.22"/></Border.Effect></Border>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#34C759"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#0066CC"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EFFFFFFF" Offset="0"/><GradientStop Color="#B9E4EDFC" Offset="0.48"/><GradientStop Color="#D1F5F9FF" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBlue" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF55A7FF" Offset="0"/><GradientStop Color="#FF1279F7" Offset="0.48"/><GradientStop Color="#FF0864DF" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#10152F" />
        <SolidColorBrush x:Key="TextSecondary" Color="#727D98" />
        <SolidColorBrush x:Key="CardBackground" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1478FC" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2A85FD" />
        <SolidColorBrush x:Key="AccentBluePressed" Color="#0B65DD" />
        <SolidColorBrush x:Key="BottomPanelBackground" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="BottomPanelBorder" Color="#D2D6E4" />

        <DropShadowEffect x:Key="CardShadow" Color="#10152F" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.10" />

        <!-- macOS Traffic Light Button Style with permanently visible high-contrast glyphs -->
        <Style x:Key="TrafficLightButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="32" Height="32" Background="Transparent">
                            <Ellipse x:Name="FocusRing" Width="18" Height="18"
                                     Stroke="{StaticResource AccentBlue}" StrokeThickness="1.5"
                                     Visibility="Collapsed" />
                            <Ellipse x:Name="Dot" Width="15" Height="15"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="0.5" />
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                       FontSize="9.5" FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       SnapsToDevicePixels="True"
                                       TextOptions.TextFormattingMode="Display" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.9" />
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75" />
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Radio Button Style for UZ/RU -->
        <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RadioBorder" CornerRadius="13" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#F6FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="RadioBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="RadioBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource GlassBlue}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlueHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBluePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0B65DD" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource GlassSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F2F4F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E5E8F2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Key Tile Style -->
        <Style x:Key="KeyTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#10152F" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frame with Liquid Glass / Acrylic surface -->
    <Border x:Name="WindowRoot" BorderBrush="#80BAC7D5" BorderThickness="1" CornerRadius="20" Background="#66ECEEF5">
        <DockPanel>
            <!-- macOS Custom Title Bar -->
            <Grid DockPanel.Dock="Top" Height="48" Background="#A6FFFFFF"
                  MouseLeftButtonDown="TitleDrag"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Traffic Light Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left">
                    <Button x:Name="CloseButton" Style="{StaticResource TrafficLightButton}"
                            Background="#FF5F56" BorderBrush="#E0443E" Foreground="#4A0002" Content="×"
                            Click="Close_Click" ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource TrafficLightButton}"
                            Background="#FFBD2E" BorderBrush="#DEA123" Foreground="#573600" Content="−"
                            Click="Minimize_Click" ToolTip="Свернуть"
                            AutomationProperties.Name="Свернуть" Margin="2,0,0,0" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TrafficLightButton}"
                            Background="#27C93F" BorderBrush="#1AAB29" Foreground="#00470E" Content="+"
                            Click="Maximize_Click" ToolTip="Развернуть"
                            AutomationProperties.Name="Развернуть" Margin="2,0,0,0" />
                </StackPanel>

                <!-- Centered window title -->
                <TextBlock x:Name="WindowTitleText" Text="Yangi lotin" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <!-- Main Content Area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,2,24,16">
                <StackPanel>
                    <!-- Header Section: Title, Subtitle, Lang Switcher & Layout Badge -->
                    <Grid Margin="8,2,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/yangi-logo.png" Width="54" Height="54" Stretch="Uniform" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Yangi lotin klaviatura"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderTitleText" Text="Yangi lotin klaviatura" FontFamily="Georgia" FontSize="25" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeaderSubtitleText" Text="O‘zbekcha klaviatura" Tag="Узбекская клавиатура" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Language Switcher UZ / RU -->
                            <Border Background="{DynamicResource GlassSurface}" BorderBrush="#73FFFFFF" BorderThickness="1" CornerRadius="15" Padding="2" Margin="0,0,10,0" SnapsToDevicePixels="True" AutomationProperties.Name="Tilni tanlash (UZ/RU)">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LangUz" Content="UZ" GroupName="AppLang" Click="LangUz_Click" IsChecked="True" Style="{StaticResource SegmentedRadioStyle}" AutomationProperties.Name="O‘zbek tili" />
                                    <RadioButton x:Name="LangRu" Content="RU" GroupName="AppLang" Click="LangRu_Click" Style="{StaticResource SegmentedRadioStyle}" AutomationProperties.Name="Русский язык" />
                                </StackPanel>
                            </Border>
                            <!-- Layout Badge -->
                            <Border Background="{DynamicResource GlassSurface}" BorderBrush="#73FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                                <TextBlock x:Name="LayoutBadgeText" Text="UZB LAT" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Status Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,12" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StatusCardTitleText" Text="Klaviatura holati" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="StatusText" Text="O‘chirilgan" FontSize="16" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ToggleButton" Content="Yoqish" Click="Toggle_Click"
                                    Style="{StaticResource PrimaryButton}" MinWidth="140" Height="40" FontSize="16"
                                    AutomationProperties.Name="Klaviaturani yoqish yoki o‘chirish" />
                        </Grid>
                    </Border>

                    <!-- New Letters Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,12" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock x:Name="KeysCardTitleText" Text="Yangi harflar" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="KeysCardSubtitleText" Text="Standart klaviatura tugmalari yangi harflarga mos keladi" FontSize="16" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,14" TextWrapping="Wrap" />
                            <UniformGrid Columns="4" Margin="-7,0">
                                <Border Style="{StaticResource KeyTile}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ç ç" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="KeyHint1" Text="ch" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KeyTile}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ö ö" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="KeyHint2" Text="o'" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KeyTile}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ş ş" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="KeyHint3" Text="sh" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KeyTile}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ğ ğ" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="KeyHint4" Text="g'" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Test Input Card -->
                    <TextBlock x:Name="InputCardTitleText" Text="Sinab ko‘ring" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,3" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Margin="4,9,4,0" Text="Matnni bu yerga yozing..." Foreground="{DynamicResource TextSecondary}" FontSize="16" VerticalAlignment="Top" IsHitTestVisible="False" />
                            <TextBox x:Name="TestInput" Padding="4,9,4,9" TextChanged="TestInput_Changed" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="16" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Klaviaturani tekshirish maydoni" />
                        </Grid>
                    </Border>

                    <Button x:Name="ConvertButton" Content="Matnni o‘zgartirish" Click="Convert_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,14" />
                    <TextBlock x:Name="ConvertInfo" Text="sh → ş · ch → ç · o' → ö · g' → ğ" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="2,0,0,14" TextWrapping="Wrap" />
                    <!-- Language Settings Hint -->
                    <Border Background="{StaticResource BottomPanelBackground}" BorderBrush="{StaticResource BottomPanelBorder}" BorderThickness="1" CornerRadius="14" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HintTextBlock" Text="Windows sozlamalarida o‘zbek lotin tilini tanlang va klaviaturani yoqing. Oyna yopilganda amal to‘xtaydi."
                                       FontSize="15" Foreground="{DynamicResource TextSecondary}" LineHeight="19" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="365" Margin="0,0,12,0" />
                            <Button Grid.Column="1" x:Name="SettingsButton" Content="Til sozlamalari" Click="Settings_Click" Style="{StaticResource SecondaryButton}" FontSize="15" MinWidth="175" Height="39" VerticalAlignment="Center" AutomationProperties.Name="Til sozlamalarini ochish" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>






